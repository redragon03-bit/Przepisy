# Skopiuj jako .env i uzupełnij (plik .env NIE trafia do repo).
APP_PASSWORD=zmien-mnie
# AI: wystarczy jeden klucz. auto = użyj tego, który jest podany.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Używany, gdy główny model jest przeciążony
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Zapasowe darmowe AI (pytane, gdy Gemini zawiedzie)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Opcjonalnie: wysyłanie listy zakupów do Home Assistant (poza dodatkiem HA)
HA_URL=
HA_TOKEN=
HA_TODO_ENTITY=todo.shopping_list
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
