# Skopiuj jako .env i uzupełnij (plik .env NIE trafia do repo).
APP_PASSWORD=zmien-mnie
# AI: wystarczy jeden klucz. auto = użyj tego, który jest podany.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Używany, gdy główny model jest przeciążony
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
